{
  "python.analysis.extraPaths": ["src"],
  "python.formatting.provider": "black",
  "editor.formatOnSave": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true
  }
}
