{
  "title": "CREDENCE — Live Risk & Drift",
  "uid": "credence-main",
  "timezone": "utc",
  "refresh": "5s",
  "panels": [
    {"type": "stat", "title": "Last PD", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "credence_last_pd"}],
     "fieldConfig": {"defaults": {"decimals": 3}}},
    {"type": "stat", "title": "Drifted share", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "credence_drift_share"}],
     "fieldConfig": {"defaults": {"thresholds": {"steps": [
       {"color": "green", "value": null},
       {"color": "orange", "value": 0.1},
       {"color": "red", "value": 0.3}]}}}},
    {"type": "timeseries", "title": "Request latency p95 (s)",
     "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "histogram_quantile(0.95, sum(rate(credence_request_latency_seconds_bucket[5m])) by (le, path))"}]},
    {"type": "timeseries", "title": "PSI by feature",
     "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "targets": [{"expr": "credence_psi"}],
     "fieldConfig": {"defaults": {"thresholds": {"steps": [
       {"color": "green", "value": null},
       {"color": "orange", "value": 0.1},
       {"color": "red", "value": 0.25}]}}}},
    {"type": "timeseries", "title": "Requests / s",
     "gridPos": {"x": 12, "y": 8, "w": 12, "h": 7},
     "targets": [{"expr": "sum(rate(credence_requests_total[1m]))"}]}
  ],
  "schemaVersion": 39, "version": 1
}
